# 前端运行环境配置（模板，复制为 .env 后填入真实值）
VITE_USE_MOCK=false
VITE_API_BASE=/api
VITE_AI_BASE=/ai
VITE_WS_BASE=ws://localhost:8092/ws

# 高德地图（Web 端 JS API）
# 申请：https://lbs.amap.com/ → 控制台 → 应用管理 → 创建应用 → 添加 Key（选 Web端 JS API）
# 安全密钥 securityJsCode 为 2021 年底起强制要求，SDK 加载前必须设置
VITE_AMAP_KEY=Please apply for your own key at https://lbs.amap.com and replace this placeholder
VITE_AMAP_SECURITY_CODE=Please apply for your own security code at https://lbs.amap.com and replace this placeholder
