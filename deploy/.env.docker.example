# ============================================================
# 云南省自然灾害应急响应平台 - Docker 环境变量配置
#
# 使用方法:
#   cp .env.docker.example .env
#   按需修改下方变量后执行:  docker compose up -d --build
#
# 注意: .env 文件包含敏感信息，请勿提交到版本库（已在 .gitignore 中忽略）
# ============================================================

# ============== 端口 ==============
# 前端对外访问端口（访问地址 http://localhost:${FRONTEND_PORT}）
FRONTEND_PORT=8088

# ============== MySQL ==============
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=emergency_auth
# 宿主机映射端口（默认 3307，避免与本地 MySQL 冲突）
MYSQL_HOST_PORT=3307

# ============== Neo4j ==============
# 注意: 首次启动初始化后修改密码无效，需删除 neo4j_data 卷重建
NEO4J_PASSWORD=disaster2026

# ============== Redis ==============
# 留空表示无密码
REDIS_PASSWORD=

# ============== 后端安全 ==============
# JWT 密钥（至少 32 字节），生产环境务必修改
JWT_SECRET=YnNpEMR4VkZzT3pHWk5rQmFPeU1KV2dsc2J4dXRoaXZmd3l6MTIzNDU2Nzg5
# 允许跨域的前端源，逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8088

# ============== Dify 配置 ==============
# Dify 实例地址；若 Dify 部署在宿主机，默认 host.docker.internal:8080 即可
# 若 Dify 也在 Docker 中，可改为 http://<dify容器名或网络地址>:8080
DIFY_BASE_URL=http://host.docker.internal:8080
# 调度方案工作流应用密钥
DIFY_API_KEY=
# 知识库数据集密钥
DIFY_DATASET_API_KEY=

# ============== LLM 降级配置 ==============
# Dify 失败后使用的 DeepSeek 模型
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ============== JVM 参数（可选） ==============
JAVA_OPTS=-Xms256m -Xmx768m
