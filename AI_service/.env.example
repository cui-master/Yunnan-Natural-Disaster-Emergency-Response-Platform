# ============== FastAPI 服务配置 ==============
APP_NAME=云南省自然灾害应急决策AI服务
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ============== Neo4j 图数据库配置 ==============
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j

# ============== Dify 工作流配置 ==============
DIFY_BASE_URL=http://localhost:5001
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_WORKFLOW_ID=natural-disaster-workflow

# ============== 业务配置 ==============
RISK_LEVEL_SYNC_INTERVAL_MINUTES=30
