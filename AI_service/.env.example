# ============== FastAPI 服务配置 ==============
APP_NAME=云南省自然灾害应急决策AI服务
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ============== Neo4j 图数据库配置 ==============
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j

# ============== Dify 工作流配置（方案生成，应用密钥 app-xxx） ==============
DIFY_BASE_URL=http://localhost:8083
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_WORKFLOW_ID=natural-disaster-workflow

# ============== Dify 知识库配置（Dataset API Key，dataset-xxx，与工作流密钥不同！） ==============
DIFY_DATASET_BASE_URL=http://localhost:8083
DIFY_DATASET_API_KEY=dataset-xxxxxxxxxxxxxxxxxxxxxxxx
# 知识库名称 -> dataset_id 映射（与 docs/knowledge-base-api.md 一致）
KB_OPTIMIZE_DISPATCH_ID=a154e469-3acd-4c33-bcdc-ea65d0886488
KB_RISK_ASSESSMENT_ID=03d787b9-e585-4b85-abbe-332e208c6530

# ============== 业务配置 ==============
RISK_LEVEL_SYNC_INTERVAL_MINUTES=30
