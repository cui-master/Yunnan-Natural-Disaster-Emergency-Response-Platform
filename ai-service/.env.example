# ============== FastAPI 服务配置 ==============
APP_NAME=云南省自然灾害应急决策AI服务
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8050
DEBUG=true

# ============== Neo4j 图数据库配置 ==============
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j

# ============== Dify 工作流配置 ==============
# 调度方案工作流（应用密钥）
DIFY_BASE_URL=http://localhost:5001
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_WORKFLOW_ID=natural-disaster-workflow

# 调度方案工作流输入变量名（需与 Dify 工作流中定义的变量名保持一致）
# 如果工作流里没有某个变量，把对应行注释掉或留空，代码就不会发送该字段
DIFY_INPUT_EVENT_NAME=event_name
DIFY_INPUT_LOCATION=location
DIFY_INPUT_EVENT_TYPE=event_type
DIFY_INPUT_SEVERITY=severity
DIFY_INPUT_AFFECTED_PEOPLE=affected_people
DIFY_INPUT_TRIPLES=neo4j
DIFY_INPUT_RISK_INFO=risk_info
DIFY_INPUT_VISION_TEXT=vision_text

# 风险评估工作流（单独的应用密钥，留空则复用 DIFY_API_KEY）
DIFY_RISK_API_KEY=

# ============== Dify 知识库配置 ==============
# 注意：使用数据集密钥（Dataset API Key），不是应用密钥！
DIFY_DATASET_BASE_URL=http://localhost:5001
DIFY_DATASET_API_KEY=dataset-xxxxxxxxxxxxxxxxxxxxxxxx

# 知识库名称与 ID 映射
# 优化调度知识库
KB_OPTIMIZE_DISPATCH_ID=a154e469-3acd-4c33-bcdc-ea65d0886488
# 风险评估知识库
KB_RISK_ASSESSMENT_ID=03d787b9-e585-4b85-abbe-332e208c6530

# ============== LLM 降级配置 ==============
# Dify 失败后使用的 LLM provider（deepseek / qwen），可被 admin 接口动态修改
LLM_PROVIDER=deepseek

# DeepSeek V4 推理模型（会产生 reasoning_content）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxx
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 通义千问（OpenAI 兼容协议）
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ============== 业务配置 ==============
RISK_LEVEL_SYNC_INTERVAL_MINUTES=30

# ============== 本地三元组 JSON 图谱（替代 Neo4j）==============
GRAPH_TRIPLES_JSON_PATH=
