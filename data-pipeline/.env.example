# App
APP_NAME=云南省自然灾害应急决策数据管道服务
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Crawler
CRAWLER_INTERVAL_MINUTES=30
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
ENABLE_MOCK_CRAWLER=false
ENABLE_YUNNAN_NET_CRAWLER=true

# SSE
SSE_KEEPALIVE_INTERVAL=15
SSE_RETRY_TIMEOUT=3000

# 云南网爬虫关键词（英文逗号分隔）
# 格式：地点 + 灾害类型，多个关键词用英文逗号分隔
YUNNAN_NET_KEYWORDS=云南 地震,云南 洪水,云南 暴雨,云南 山体滑坡,云南 泥石流,云南 森林火灾,云南 干旱,云南 冰雹,云南 灾害,昆明 地震,昭通 洪涝,曲靖 灾害,丽江 滑坡,普洱 地震,大理 地震
